# The portable build's inputs, pinned, in one file. Sourced by POSIX shell, so:
# plain `NAME=value`, no expansion, no quotes needed.

# AlmaLinux 8 as the manylinux project maintains it, pinned by digest rather
# than by tag: the glibc floor this image sets is the compatibility promise the
# AppImage makes, and a tag can move under it. Same digest as ../Sterna uses,
# which is where this recipe comes from.
MANYLINUX_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:f854c50adf7b7a325bc4794316f3758d387a41d61f9e2ebca0f26c7dc8f761d4

QT_VERSION=6.11.1
QT_PREFIX=packaging/appimage/toolchain/qt-6.11.1

# How much of the machine the container may take. Qt Base is the longest build
# in this repository by a wide margin and it is easy to make a desktop
# unusable for half an hour; these leave most of a 16-core machine alone.
BUILD_JOBS=6
BUILD_CPUS=6
