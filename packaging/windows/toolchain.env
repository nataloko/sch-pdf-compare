# The Windows build's inputs, pinned, in one file. Sourced by POSIX shell, so:
# plain `NAME=value`, no expansion, no quotes needed.

# Fedora, pinned by digest rather than by tag, and Fedora specifically: it is
# the distribution that packages a MinGW Qt 6 whose moc, rcc and uic run on the
# build machine. Ubuntu does not, which is the whole reason this build happens
# in a container rather than wherever the developer is standing.
FEDORA_IMAGE=registry.fedoraproject.org/fedora@sha256:013127c6af6cd1b4368c71f25a043b268fc0d195f6a6f73d48f0b8366c117131

# How much of the machine the container may take. MuPDF is the long build here
# and takes about a minute with these.
BUILD_JOBS=6
BUILD_CPUS=6
